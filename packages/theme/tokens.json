{
  "$description": "HFKit design tokens. W3C Design Tokens format ($value/$type). Single source of truth — see README.md for the token-layer rules before editing.",

  "primitive": {
    "$description": "Layer 1: raw values, no meaning. Never referenced directly by components — only by semantic/component tokens or the generators.",

    "color": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#000000" },

      "gray": {
        "50":  { "$type": "color", "$value": "#f4f5f5" },
        "100": { "$type": "color", "$value": "#d9dbdd" },
        "200": { "$type": "color", "$value": "#b9bcc1" },
        "300": { "$type": "color", "$value": "#9ba0a6" },
        "400": { "$type": "color", "$value": "#80868e" },
        "500": { "$type": "color", "$value": "#696f77" },
        "600": { "$type": "color", "$value": "#565b61" },
        "700": { "$type": "color", "$value": "#46494e" },
        "800": { "$type": "color", "$value": "#373a3e" },
        "850": { "$type": "color", "$value": "#2b2d31" },
        "900": { "$type": "color", "$value": "#222326" },
        "925": { "$type": "color", "$value": "#18191b" },
        "950": { "$type": "color", "$value": "#111213" },
        "975": { "$type": "color", "$value": "#0a0a0b" }
      },

      "blue": {
        "$description": "The single interactive accent hue for field-dark/field-light. A restrained steel blue — not the neon/indigo AI gradient family.",
        "200": { "$type": "color", "$value": "#8bb9e4" },
        "300": { "$type": "color", "$value": "#6aa5dc" },
        "400": { "$type": "color", "$value": "#4991d4" },
        "500": { "$type": "color", "$value": "#2f7dc6" },
        "600": { "$type": "color", "$value": "#2768a5" },
        "700": { "$type": "color", "$value": "#1f5384" },
        "800": { "$type": "color", "$value": "#173e63" }
      },

      "green":  {
        "300": { "$type": "color", "$value": "#6adc9f" },
        "400": { "$type": "color", "$value": "#49d48a" },
        "500": { "$type": "color", "$value": "#2fc675" },
        "600": { "$type": "color", "$value": "#27a562" },
        "700": { "$type": "color", "$value": "#1d7c49" },
        "800": { "$type": "color", "$value": "#17633b" }
      },
      "amber": {
        "300": { "$type": "color", "$value": "#dcba6a" },
        "400": { "$type": "color", "$value": "#d4ab49" },
        "500": { "$type": "color", "$value": "#c6992f" },
        "600": { "$type": "color", "$value": "#a57f27" },
        "650": { "$type": "color", "$value": "#9d7925" },
        "700": { "$type": "color", "$value": "#84661f" },
        "800": { "$type": "color", "$value": "#634c17" }
      },
      "orange": {
        "300": { "$type": "color", "$value": "#dc9c6a" },
        "400": { "$type": "color", "$value": "#d48649" },
        "500": { "$type": "color", "$value": "#c6702f" },
        "600": { "$type": "color", "$value": "#a55e27" },
        "700": { "$type": "color", "$value": "#844b1f" },
        "800": { "$type": "color", "$value": "#633817" }
      },
      "red": {
        "300": { "$type": "color", "$value": "#dc746a" },
        "400": { "$type": "color", "$value": "#d45549" },
        "500": { "$type": "color", "$value": "#c63b2f" },
        "600": { "$type": "color", "$value": "#a53127" },
        "700": { "$type": "color", "$value": "#84271f" },
        "800": { "$type": "color", "$value": "#631e17" }
      },
      "slate": {
        "$description": "Desaturated blue-gray reserved for the 'stale' status — deliberately quieter than the gray neutral so staleness reads as muted, not just gray UI chrome.",
        "300": { "$type": "color", "$value": "#aeb7c2" },
        "400": { "$type": "color", "$value": "#96a2b0" },
        "500": { "$type": "color", "$value": "#7f8d9f" },
        "600": { "$type": "color", "$value": "#69798c" },
        "700": { "$type": "color", "$value": "#586574" },
        "800": { "$type": "color", "$value": "#46505d" }
      },

      "ember": {
        "$description": "Warm near-monochrome neutral scale used ONLY by the night-ops theme (red-shifted, night-vision-preserving). Deliberately not shared with the gray scale so the third theme is a genuinely different palette family, not a recolored field theme.",
        "0":   { "$type": "color", "$value": "#100504" },
        "50":  { "$type": "color", "$value": "#180807" },
        "100": { "$type": "color", "$value": "#220d0b" },
        "200": { "$type": "color", "$value": "#2d1d1b" },
        "300": { "$type": "color", "$value": "#533632" },
        "400": { "$type": "color", "$value": "#865750" },
        "500": { "$type": "color", "$value": "#c46d64" },
        "600": { "$type": "color", "$value": "#d37369" },
        "700": { "$type": "color", "$value": "#f1a59d" },
        "950": { "$type": "color", "$value": "#fbefec" }
      },
      "signal": {
        "$description": "Night-ops accent + status hues. Stays within the red/orange/amber warm band on purpose — no blue or green, to preserve dark adaptation.",
        "accentFill": { "$type": "color", "$value": "#bf223c" },
        "accentText": { "$type": "color", "$value": "#ee8b9c" },
        "goodFill":   { "$type": "color", "$value": "#cda11d" },
        "goodText":   { "$type": "color", "$value": "#ebd48e" },
        "fairFill":   { "$type": "color", "$value": "#cd751d" },
        "fairText":   { "$type": "color", "$value": "#ebbd8e" },
        "poorFill":   { "$type": "color", "$value": "#ad421f" },
        "poorText":   { "$type": "color", "$value": "#e89f87" },
        "closedFill": { "$type": "color", "$value": "#b12525" },
        "closedText": { "$type": "color", "$value": "#ea9090" },
        "staleFill":  { "$type": "color", "$value": "#7a645c" },
        "staleText":  { "$type": "color", "$value": "#b4a29c" }
      },

      "sequential": {
        "$description": "Colorblind-safe sequential ramp (cividis-family: blue -> gray -> yellow, monotonic lightness, no red/green transition) for continuous fields like MUF and coverage heatmaps. Shared by field-dark and field-light — it encodes a physical quantity, not app chrome.",
        "0": { "$type": "color", "$value": "#00204d" },
        "1": { "$type": "color", "$value": "#00336f" },
        "2": { "$type": "color", "$value": "#39486b" },
        "3": { "$type": "color", "$value": "#575d6d" },
        "4": { "$type": "color", "$value": "#707173" },
        "5": { "$type": "color", "$value": "#8a8678" },
        "6": { "$type": "color", "$value": "#a69d75" },
        "7": { "$type": "color", "$value": "#ffea46" }
      },
      "categorical": {
        "$description": "Okabe-Ito colorblind-safe categorical palette for multi-series charts. Shared by field-dark and field-light.",
        "0": { "$type": "color", "$value": "#e69f00" },
        "1": { "$type": "color", "$value": "#56b4e9" },
        "2": { "$type": "color", "$value": "#009e73" },
        "3": { "$type": "color", "$value": "#f0e442" },
        "4": { "$type": "color", "$value": "#0072b2" },
        "5": { "$type": "color", "$value": "#d55e00" },
        "6": { "$type": "color", "$value": "#cc79a7" },
        "7": { "$type": "color", "$value": "#999999" }
      },
      "nightSequential": {
        "$description": "Night-ops sequential ramp: single warm hue, lightness-only sweep (the safest possible colorblind strategy) instead of the blue-yellow ramp, to stay within the red-shifted palette.",
        "0": { "$type": "color", "$value": "#2a1310" },
        "1": { "$type": "color", "$value": "#4a201a" },
        "2": { "$type": "color", "$value": "#743224" },
        "3": { "$type": "color", "$value": "#a5492a" },
        "4": { "$type": "color", "$value": "#cf6b2f" },
        "5": { "$type": "color", "$value": "#e89a3f" },
        "6": { "$type": "color", "$value": "#f5c469" },
        "7": { "$type": "color", "$value": "#fbe6ad" }
      },
      "nightCategorical": {
        "$description": "Night-ops categorical series palette. Warm-only hues (amber/orange/red/rose/brown) so the theme never emits blue or green.",
        "0": { "$type": "color", "$value": "#dfb920" },
        "1": { "$type": "color", "$value": "#d6995c" },
        "2": { "$type": "color", "$value": "#df4620" },
        "3": { "$type": "color", "$value": "#d65c66" },
        "4": { "$type": "color", "$value": "#df2070" },
        "5": { "$type": "color", "$value": "#816b56" }
      }
    },

    "spacing": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "4px" },
      "2":  { "$type": "dimension", "$value": "8px" },
      "3":  { "$type": "dimension", "$value": "12px" },
      "4":  { "$type": "dimension", "$value": "16px" },
      "5":  { "$type": "dimension", "$value": "20px" },
      "6":  { "$type": "dimension", "$value": "24px" },
      "8":  { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "20": { "$type": "dimension", "$value": "80px" },
      "24": { "$type": "dimension", "$value": "96px" }
    },

    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "sm":   { "$type": "dimension", "$value": "2px" },
      "md":   { "$type": "dimension", "$value": "4px" },
      "lg":   { "$type": "dimension", "$value": "8px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },

    "borderWidth": {
      "1": { "$type": "dimension", "$value": "1px" },
      "2": { "$type": "dimension", "$value": "2px" }
    },

    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$description": "System UI stack — no webfonts.",
        "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$description": "Tabular-figure monospace for frequencies, UTC times, indices — values must align in columns.",
        "$value": ["ui-monospace", "SF Mono", "Cascadia Mono", "JetBrains Mono", "Consolas", "Liberation Mono", "monospace"]
      }
    },

    "fontSize": {
      "xs":  { "$type": "dimension", "$value": "11px" },
      "sm":  { "$type": "dimension", "$value": "12px" },
      "base":{ "$type": "dimension", "$value": "14px" },
      "md":  { "$type": "dimension", "$value": "16px" },
      "lg":  { "$type": "dimension", "$value": "18px" },
      "xl":  { "$type": "dimension", "$value": "22px" },
      "2xl": { "$type": "dimension", "$value": "28px" },
      "3xl": { "$type": "dimension", "$value": "36px" }
    },

    "fontWeight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },

    "lineHeight": {
      "tight":   { "$type": "number", "$value": 1.15 },
      "normal":  { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    },

    "duration": {
      "$description": "Motion is functional only, <=150ms. Nothing loops, nothing glows.",
      "fast": { "$type": "duration", "$value": "100ms" },
      "base": { "$type": "duration", "$value": "150ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },

  "semantic": {
    "$description": "Layer 2: meaning, referencing primitives. One block per theme, same key names in every theme -- this identical shape is what makes reskinning a one-file change.",

    "field-dark": {
      "$description": "Default theme. Flat, high-contrast, dark. Instrument-panel reference.",
      "surface": {
        "default": { "$type": "color", "$value": "{primitive.color.gray.950}" },
        "raised":  { "$type": "color", "$value": "{primitive.color.gray.900}" },
        "sunken":  { "$type": "color", "$value": "{primitive.color.gray.975}" },
        "overlay": { "$type": "color", "$value": "{primitive.color.gray.850}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.color.gray.50}" },
        "secondary": { "$type": "color", "$value": "{primitive.color.gray.200}" },
        "muted":     { "$type": "color", "$value": "{primitive.color.gray.300}" },
        "inverse":   { "$type": "color", "$value": "{primitive.color.gray.975}" },
        "disabled":  { "$type": "color", "$value": "{primitive.color.gray.600}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{primitive.color.gray.850}" },
        "default": { "$type": "color", "$value": "{primitive.color.gray.700}" },
        "strong":  { "$type": "color", "$value": "{primitive.color.gray.500}" }
      },
      "accent": {
        "interactive":       { "$type": "color", "$value": "{primitive.color.blue.400}" },
        "interactiveHover":  { "$type": "color", "$value": "{primitive.color.blue.300}" },
        "interactiveActive": { "$type": "color", "$value": "{primitive.color.blue.500}" },
        "onAccent":          { "$type": "color", "$value": "{primitive.color.gray.975}" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.color.blue.300}" }
      },
      "status": {
        "good":   { "fill": { "$type": "color", "$value": "{primitive.color.green.700}" },  "on": { "$type": "color", "$value": "{primitive.color.white}" },  "text": { "$type": "color", "$value": "{primitive.color.green.400}" } },
        "fair":   { "fill": { "$type": "color", "$value": "{primitive.color.amber.650}" },  "on": { "$type": "color", "$value": "{primitive.color.gray.975}" }, "text": { "$type": "color", "$value": "{primitive.color.amber.400}" } },
        "poor":   { "fill": { "$type": "color", "$value": "{primitive.color.orange.700}" }, "on": { "$type": "color", "$value": "{primitive.color.gray.50}" },  "text": { "$type": "color", "$value": "{primitive.color.orange.400}" } },
        "closed": { "fill": { "$type": "color", "$value": "{primitive.color.red.600}" },    "on": { "$type": "color", "$value": "{primitive.color.gray.50}" },  "text": { "$type": "color", "$value": "{primitive.color.red.400}" } },
        "stale":  { "fill": { "$type": "color", "$value": "{primitive.color.slate.700}" },  "on": { "$type": "color", "$value": "{primitive.color.gray.50}" },  "text": { "$type": "color", "$value": "{primitive.color.slate.400}" } }
      }
    },

    "field-light": {
      "$description": "First-class daylight theme, not a washed-out afterthought. Same instrument-panel references, inverted for a bright field table or truck cab in sunlight.",
      "surface": {
        "default": { "$type": "color", "$value": "{primitive.color.gray.50}" },
        "raised":  { "$type": "color", "$value": "{primitive.color.white}" },
        "sunken":  { "$type": "color", "$value": "{primitive.color.gray.100}" },
        "overlay": { "$type": "color", "$value": "{primitive.color.white}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.color.gray.975}" },
        "secondary": { "$type": "color", "$value": "{primitive.color.gray.700}" },
        "muted":     { "$type": "color", "$value": "{primitive.color.gray.600}" },
        "inverse":   { "$type": "color", "$value": "{primitive.color.gray.50}" },
        "disabled":  { "$type": "color", "$value": "{primitive.color.gray.400}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{primitive.color.gray.200}" },
        "default": { "$type": "color", "$value": "{primitive.color.gray.300}" },
        "strong":  { "$type": "color", "$value": "{primitive.color.gray.500}" }
      },
      "accent": {
        "interactive":       { "$type": "color", "$value": "{primitive.color.blue.600}" },
        "interactiveHover":  { "$type": "color", "$value": "{primitive.color.blue.700}" },
        "interactiveActive": { "$type": "color", "$value": "{primitive.color.blue.800}" },
        "onAccent":          { "$type": "color", "$value": "{primitive.color.gray.50}" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.color.blue.600}" }
      },
      "status": {
        "good":   { "fill": { "$type": "color", "$value": "{primitive.color.green.700}" },  "on": { "$type": "color", "$value": "{primitive.color.white}" }, "text": { "$type": "color", "$value": "{primitive.color.green.800}" } },
        "fair":   { "fill": { "$type": "color", "$value": "{primitive.color.amber.600}" },  "on": { "$type": "color", "$value": "{primitive.color.gray.975}" }, "text": { "$type": "color", "$value": "{primitive.color.amber.800}" } },
        "poor":   { "fill": { "$type": "color", "$value": "{primitive.color.orange.700}" }, "on": { "$type": "color", "$value": "{primitive.color.white}" }, "text": { "$type": "color", "$value": "{primitive.color.orange.800}" } },
        "closed": { "fill": { "$type": "color", "$value": "{primitive.color.red.700}" },    "on": { "$type": "color", "$value": "{primitive.color.white}" }, "text": { "$type": "color", "$value": "{primitive.color.red.700}" } },
        "stale":  { "fill": { "$type": "color", "$value": "{primitive.color.slate.700}" },  "on": { "$type": "color", "$value": "{primitive.color.white}" }, "text": { "$type": "color", "$value": "{primitive.color.slate.800}" } }
      }
    },

    "night-ops": {
      "$description": "Deliberately different third theme: red-shifted / night-vision-preserving. Warm-only palette (ember neutrals + signal hues), no blue or green anywhere. Proves the reskin path -- same semantic keys, completely different family of primitives underneath.",
      "surface": {
        "default": { "$type": "color", "$value": "{primitive.color.ember.50}" },
        "raised":  { "$type": "color", "$value": "{primitive.color.ember.100}" },
        "sunken":  { "$type": "color", "$value": "{primitive.color.ember.0}" },
        "overlay": { "$type": "color", "$value": "{primitive.color.ember.100}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.color.ember.700}" },
        "secondary": { "$type": "color", "$value": "{primitive.color.ember.600}" },
        "muted":     { "$type": "color", "$value": "{primitive.color.ember.500}" },
        "inverse":   { "$type": "color", "$value": "{primitive.color.ember.50}" },
        "disabled":  { "$type": "color", "$value": "{primitive.color.ember.400}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{primitive.color.ember.200}" },
        "default": { "$type": "color", "$value": "{primitive.color.ember.300}" },
        "strong":  { "$type": "color", "$value": "{primitive.color.ember.400}" }
      },
      "accent": {
        "interactive":       { "$type": "color", "$value": "{primitive.color.signal.accentFill}" },
        "interactiveHover":  { "$type": "color", "$value": "{primitive.color.signal.accentText}" },
        "interactiveActive": { "$type": "color", "$value": "{primitive.color.ember.700}" },
        "onAccent":          { "$type": "color", "$value": "{primitive.color.ember.950}" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.color.signal.accentText}" }
      },
      "status": {
        "good":   { "fill": { "$type": "color", "$value": "{primitive.color.signal.goodFill}" },   "on": { "$type": "color", "$value": "{primitive.color.ember.50}" },   "text": { "$type": "color", "$value": "{primitive.color.signal.goodText}" } },
        "fair":   { "fill": { "$type": "color", "$value": "{primitive.color.signal.fairFill}" },   "on": { "$type": "color", "$value": "{primitive.color.ember.50}" },   "text": { "$type": "color", "$value": "{primitive.color.signal.fairText}" } },
        "poor":   { "fill": { "$type": "color", "$value": "{primitive.color.signal.poorFill}" },   "on": { "$type": "color", "$value": "{primitive.color.ember.950}" }, "text": { "$type": "color", "$value": "{primitive.color.signal.poorText}" } },
        "closed": { "fill": { "$type": "color", "$value": "{primitive.color.signal.closedFill}" }, "on": { "$type": "color", "$value": "{primitive.color.ember.950}" }, "text": { "$type": "color", "$value": "{primitive.color.signal.closedText}" } },
        "stale":  { "fill": { "$type": "color", "$value": "{primitive.color.signal.staleFill}" },  "on": { "$type": "color", "$value": "{primitive.color.ember.950}" }, "text": { "$type": "color", "$value": "{primitive.color.signal.staleText}" } }
      }
    }
  },

  "component": {
    "$description": "Layer 3: defined once, referencing {semantic.*} generically -- resolved per-theme so a single definition yields the right value under every theme. Add a component token only when a component genuinely needs a value semantic tokens don't already express.",

    "card": {
      "padding":    { "$type": "dimension", "$value": "{primitive.spacing.4}" },
      "gap":        { "$type": "dimension", "$value": "{primitive.spacing.3}" },
      "radius":     { "$type": "dimension", "$value": "{primitive.radius.md}" },
      "background": { "$type": "color",     "$value": "{semantic.surface.raised}" },
      "border":     { "$type": "color",     "$value": "{semantic.border.subtle}" }
    },
    "button": {
      "paddingX":        { "$type": "dimension", "$value": "{primitive.spacing.4}" },
      "paddingY":        { "$type": "dimension", "$value": "{primitive.spacing.2}" },
      "radius":          { "$type": "dimension", "$value": "{primitive.radius.sm}" },
      "background":      { "$type": "color",     "$value": "{semantic.accent.interactive}" },
      "backgroundHover": { "$type": "color",     "$value": "{semantic.accent.interactiveHover}" },
      "backgroundActive":{ "$type": "color",     "$value": "{semantic.accent.interactiveActive}" },
      "foreground":      { "$type": "color",     "$value": "{semantic.accent.onAccent}" },
      "border":          { "$type": "color",     "$value": "{semantic.accent.interactive}" }
    },
    "badge": {
      "paddingX": { "$type": "dimension", "$value": "{primitive.spacing.2}" },
      "paddingY": { "$type": "dimension", "$value": "{primitive.spacing.1}" },
      "radius":   { "$type": "dimension", "$value": "{primitive.radius.full}" },
      "gap":      { "$type": "dimension", "$value": "{primitive.spacing.1}" },
      "border":   { "$type": "color",     "$value": "{semantic.border.default}" }
    },
    "dataRow": {
      "$description": "A data table / list row showing a timestamped value (e.g. a scored frequency).",
      "paddingX":       { "$type": "dimension", "$value": "{primitive.spacing.3}" },
      "paddingY":       { "$type": "dimension", "$value": "{primitive.spacing.2}" },
      "background":     { "$type": "color",     "$value": "{semantic.surface.raised}" },
      "backgroundAlt":  { "$type": "color",     "$value": "{semantic.surface.sunken}" },
      "border":         { "$type": "color",     "$value": "{semantic.border.subtle}" },
      "valueForeground":{ "$type": "color",     "$value": "{semantic.text.primary}" },
      "timestampForeground": { "$type": "color", "$value": "{semantic.text.muted}" }
    },
    "focusRing": {
      "width":  { "$type": "dimension", "$value": "{primitive.borderWidth.2}" },
