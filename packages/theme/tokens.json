    },
    "map": {
      "$description": "Feeds the MapLibre style generator. Maps stay quiet/low-saturation; data overlays are the loud part.",
      "background": { "$type": "color", "$value": "{semantic.surface.default}" },
      "land":       { "$type": "color", "$value": "{semantic.surface.default}" },
      "water":      { "$type": "color", "$value": "{semantic.surface.sunken}" },
      "building":   { "$type": "color", "$value": "{semantic.surface.raised}" },
      "boundary":   { "$type": "color", "$value": "{semantic.border.default}" },
      "road":       { "$type": "color", "$value": "{semantic.border.strong}" },
      "label":      { "$type": "color", "$value": "{semantic.text.secondary}" },
      "labelHalo":  { "$type": "color", "$value": "{semantic.surface.default}" }
    }
  },

