{
  // Static-assets Worker. HFKit's Phase 1 site is entirely static — prediction
  // runs in the browser via WebAssembly (ADR-0001) — so there is no Worker
  // script at all, just the assets binding.
  //
  // Deployed by Cloudflare Workers Builds:
  //   Build command:  npm install && npm run build:web
  //   Deploy command: npx wrangler deploy
  //
  // `apps/web/vendor/` and `apps/web/data/` are generated by build:web and are
  // gitignored, so the build must run before the deploy — which is what the
  // build command above does.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hfkit",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./apps/web",
    // Serve /planner rather than requiring /planner.html, and return a real
    // 404 for unknown paths instead of silently serving the landing page.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domain. caldwell.tech is already on Cloudflare, so declaring the
  // route here makes the deploy create and maintain the DNS record itself —
  // version-controlled rather than clicked in the dashboard.
  //
  // The deploying API token needs Workers Scripts:Edit plus, for this route,
  // Zone:Read and DNS:Edit on caldwell.tech. If the token is scoped to Workers
  // only, the deploy succeeds but the route fails — add the domain in the
  // dashboard under the Worker's Domains & Routes instead.
  "routes": [
    { "pattern": "hfkit.caldwell.tech", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
